# Copy to .env for local development. Never commit a real .env.
# Values here are local-only and must not be reused anywhere deployed.

DATABASE_URL="postgresql://garm:garm_local_dev@localhost:5432/garm?schema=public"
REDIS_URL="redis://localhost:6379"

# Application-layer encryption key for national IDs, IBANs, and KYC payloads
# (SPEC §77). Generate per environment; in production this comes from a KMS,
# never from a file.
ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# Access tokens are short-lived; refresh tokens rotate with reuse detection.
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# All providers are mocks until the commercial decisions in DECISIONS.md land
# (OPEN-5 … OPEN-8).
PROVIDER_MODE="mock"
