{
  "name": "@garm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prisma:validate": "DATABASE_URL=\"${DATABASE_URL:-postgresql://garm:garm@localhost:5432/garm?schema=public}\" prisma validate",
    "typecheck": "tsc --noEmit && npm run prisma:validate",
    "lint": "eslint src test --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@garm/domain": "*",
    "@garm/financial": "*",
    "@garm/providers": "*"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  }
}
